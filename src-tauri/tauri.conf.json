{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiliaMark",
  "version": "0.1.0",
  "identifier": "com.lilialab.liliamark",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiliaMark",
        "width": 1100,
        "height": 750,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LiliaMark",
    "windows": {
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "LiliaMark.Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": ["txt"],
        "name": "LiliaMark.Text",
        "description": "Plain Text Document",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["json"],
        "name": "LiliaMark.JSON",
        "description": "JSON Document",
        "mimeType": "application/json",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "LiliaMark.YAML",
        "description": "YAML Document",
        "mimeType": "application/yaml",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["toml"],
        "name": "LiliaMark.TOML",
        "description": "TOML Document",
        "mimeType": "application/toml",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["ini", "properties"],
        "name": "LiliaMark.INI",
        "description": "INI / Properties Document",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["xml"],
        "name": "LiliaMark.XML",
        "description": "XML Document",
        "mimeType": "application/xml",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["html", "htm"],
        "name": "LiliaMark.HTML",
        "description": "HTML Document",
        "mimeType": "text/html",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
